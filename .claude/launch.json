{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel",
      "url": "http://localhost:8000",
      "port": 8000
    },
    {
      "name": "flutter-web",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S",
        "127.0.0.1:8090",
        "-t",
