# =============================================================================
# MARA BUSINESS - environment template
#
# Copy to .env and fill in. Never commit .env. Every value below is a placeholder.
# The defaults here are the PRODUCTION-SAFE ones; a developer's machine overrides
# APP_ENV=local and APP_DEBUG=true in their own .env.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME="MARA BUSINESS"
# production on the live site, local on a developer's machine
APP_ENV=production
# php artisan key:generate
APP_KEY=
# false in production: true prints stack traces (and secrets) in the browser
APP_DEBUG=false
APP_URL=https://example.com
# Absolute base URL payment gateways send customers back to. Must be publicly
# reachable; on Android the same URL is an App Link caught by the mobile app.
FRONTEND_URL=https://example.com

# Language shown when the visitor has not picked one
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Logs every SQL query when true. Development only.
LOG_QUERIES=false

# ---- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# warning in production; debug fills the disk and logs payloads
LOG_LEVEL=warning

# ---- Database ---------------------------------------------------------------
# SQLite lives in database/database.sqlite. It holds every order and customer:
# back it up (copy the file) before each deployment and on a schedule.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marabusiness
# DB_USERNAME=
# DB_PASSWORD=

# ---- Sessions, cache, queue -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true once the site is served over https (it is in production)
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync: mails and jobs run inside the request. There is no queue worker on the
# current hosting, so "database" would leave them waiting forever.
QUEUE_CONNECTION=sync

# ---- Mobile API tokens ------------------------------------------------------
# Lifetime of a Sanctum token, in minutes (129600 = 90 days)
SANCTUM_EXPIRATION=129600

# ---- Mail -------------------------------------------------------------------
# log only writes mails to storage/logs: nothing is sent. Use smtp in production.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Where the contact form delivers its messages
MAIL_ADMIN_ADDRESS="contact@example.com"

# ---- Who operates the site (legal notice, terms, privacy policy) ------------
# Printed on the legal pages. There are no defaults: fill in the REAL details; a line
# left empty is simply not shown. The phone, e-mail and address also fall back to the
# contact settings kept in the admin panel (Settings > Site Settings, group Contact).
COMPANY_NAME=
COMPANY_LEGAL_FORM=
COMPANY_CAPITAL=
# Trade register number (RCCM) and tax identification number (NIF)
COMPANY_REGISTRATION=
COMPANY_TAX_ID=
COMPANY_ADDRESS=
COMPANY_PHONE=
# One mailbox for legal, privacy, security and press requests
COMPANY_EMAIL=
# Only if different from COMPANY_EMAIL
COMPANY_DPO_EMAIL=
COMPANY_LEGAL_REPRESENTATIVE=
COMPANY_PUBLICATION_DIRECTOR=
COMPANY_HOST_NAME=
COMPANY_HOST_ADDRESS=

# ---- Card payments (Stripe) -------------------------------------------------
# sk_test_... while testing, sk_live_... in production
STRIPE_SECRET=
# Signing secret of the webhook endpoint, whsec_...
# Stripe dashboard > Developers > Webhooks > add endpoint
#   URL:    ${APP_URL}/api/payments/stripe/webhook
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded
# Without it a customer who pays then closes the tab is charged but not credited.
STRIPE_WEBHOOK_SECRET=

# ---- Mobile money and cards in Guinea (LengoPay) ----------------------------
# Sandbox: https://sandbox.lengopay.com   Production: https://portal.lengopay.com
LENGOPAY_BASE_URL=https://portal.lengopay.com
LENGOPAY_LICENSE_KEY=
LENGOPAY_WEBSITE_ID=
LENGOPAY_CURRENCY=GNF
# LengoPay must be told to call ${APP_URL}/api/payments/lengopay/callback

# ---- Social sign-in ---------------------------------------------------------
# The redirect URIs must also be registered, character for character, in the
# Google Cloud console and the Facebook developer console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/auth/facebook/callback
# Optional HTTP proxy for the Socialite providers. Leave unset in production.
# PROXY_HOST=
# PROXY_PORT=

# ---- Shipping (DHL) ---------------------------------------------------------
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
# sandbox or production
DHL_ENVIRONMENT=production

# ---- Front-end build --------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Development only: number of workers for `php artisan serve`
PHP_CLI_SERVER_WORKERS=4
