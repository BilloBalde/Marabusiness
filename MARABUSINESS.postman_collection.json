{
  "info": {
    "name": "MARABUSINESS API",
    "description": "Postman collection for the MARABUSINESS Laravel API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Environment Variables",
      "item": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Set default environment variables if not set"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Authentication routes",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\",\n  \"password_confirmation\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "forgot-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "reset-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"your-reset-token\",\n  \"email\": \"john@example.com\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Public",
      "description": "Public API routes",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ping",
              "host": ["{{base_url}}"],
              "path": ["ping"]
            }
          }
        },
        {
          "name": "Home",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/home",
              "host": ["{{base_url}}"],
              "path": ["v1", "home"]
            }
          }
        },
        {
          "name": "Products List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/products",
              "host": ["{{base_url}}"],
              "path": ["v1", "products"]
            }
          }
        },
        {
          "name": "Product Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/products/:slug/:vendor_product_id",
              "host": ["{{base_url}}"],
              "path": ["v1", "products", ":slug", ":vendor_product_id"]
            }
          }
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/categories",
              "host": ["{{base_url}}"],
              "path": ["v1", "categories"]
            }
          }
        },
        {
          "name": "Brands",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/brands",
              "host": ["{{base_url}}"],
              "path": ["v1", "brands"]
            }
          }
        },
        {
          "name": "Vendors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/vendors",
              "host": ["{{base_url}}"],
              "path": ["v1", "vendors"]
            }
          }
        },
        {
          "name": "Contact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/contact",
              "host": ["{{base_url}}"],
              "path": ["v1", "contact"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"message\": \"Hello, I need help with an order.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Protected",
      "description": "Routes that require Bearer token authentication (Sanctum)",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "logout"]
            }
          }
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/user/profile",
              "host": ["{{base_url}}"],
              "path": ["v1", "user", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/user/profile",
              "host": ["{{base_url}}"],
              "path": ["v1", "user", "profile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"phone\": \"+1234567890\"\n}"
            }
          }
        },
        {
          "name": "Cart Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/cart/summary",
              "host": ["{{base_url}}"],
              "path": ["v1", "cart", "summary"]
            }
          }
        },
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/cart/add",
              "host": ["{{base_url}}"],
              "path": ["v1", "cart", "add"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor_product_id\": 123,\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["v1", "orders"]
            }
          }
        },
        {
          "name": "Addresses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/addresses",
              "host": ["{{base_url}}"],
              "path": ["v1", "addresses"]
            }
          }
        },
        {
          "name": "Chats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/chats",
              "host": ["{{base_url}}"],
              "path": ["v1", "chats"]
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "LengoPay Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payments/lengopay/callback",
              "host": ["{{base_url}}"],
              "path": ["payments", "lengopay", "callback"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment_succeeded\",\n  \"data\": {\n    \"payment_id\": \"12345\",\n    \"status\": \"completed\"\n  }\n}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/MARABUSINESS/public/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ]
}
